NODE_ENV=production
HOST_PORT=8080
API_BASE_URL=/api
API_CLIENT_TOKEN=replace-with-long-random-token
SESSION_SIGNING_SECRET=replace-with-long-random-secret
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=beanconqueror
DB_USER=beanconqueror
DB_PASSWORD=replace-with-strong-db-password
MARIADB_ROOT_PASSWORD=replace-with-strong-root-password
GAGGIUINO_BASE_URL=http://gaggiuino.local
GAGGIUINO_AUTOSYNC_ENABLED=true
GAGGIUINO_AUTOSYNC_INTERVAL_MS=30000
GAGGIUINO_AUTOSYNC_MAX_BACKOFF_MS=300000
GAGGIUINO_AUTOSYNC_BATCH_SIZE=10
GAGGIUINO_AUTOSYNC_INITIAL_IMPORT_COUNT=6
CORS_ORIGINS=
TAILSCALE_HOSTNAMES=
TAILSCALE_ALLOW_HTTP=false
FEATURE_FLAGS_JSON={"brewSharing":true,"betaFlow":false}
